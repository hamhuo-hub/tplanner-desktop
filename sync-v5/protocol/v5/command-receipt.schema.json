{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tplanner.app/sync-v5/command-receipt.schema.json",
  "title": "Sync V5 batch response",
  "description": "HTTP 200 means the receipts are durably committed, not that every command applied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "serverId", "revision", "receipts"],
  "properties": {
    "protocolVersion": { "const": 5 },
    "serverId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "sequence", "status", "revision"],
        "properties": {
          "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "status": { "enum": ["applied", "conflict", "rejected"] },
          "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "code": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
